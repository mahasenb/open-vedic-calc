  "provenance": {
    "fields": {
      "ayanamsa_deg": {
        "independent_of_this_engine": false,
        "source": "engine",
        "what": "The Lahiri ayanamsa this engine computes. Recorded so the sidereal->tropical composition can be checked against Horizons, NOT as an independently-sourced expected value: the sidereal zero point is an astrological convention (Indian Calendar Reform Committee) with no counterpart in any solar-system ephemeris. Pinning it to a published authority is tracked as follow-up work."
      },
      "jd_tdb": {
        "independent_of_this_engine": false,
        "source": "engine (Delta-T only)",
        "what": "jd_ut + swe.deltat(jd_ut). Names WHICH TDB instant the node was requested at; both sides of the node assertion use this same instant, so Delta-T cancels out of the comparison instead of entering it as an error term."
      },
      "jd_ut": {
        "independent_of_this_engine": true,
        "source": "ci/fetch_reference_corpus.py",
        "what": "UT Julian Day by the textbook civil-calendar conversion (Meeus ch. 7), deliberately not swisseph's swe.julday."
      },
      "moon_osculating_node_j2000_deg": {
        "independent_of_this_engine": true,
        "source": "NASA/JPL Horizons",
        "what": "Longitude of the ascending node (OM) of the Moon's osculating orbit about the Earth, referred to the ECLIPTIC OF J2000.0, from Horizons EPHEM_TYPE='ELEMENTS' at the epoch's jd_tdb. This is the independent expected value for the declared lunar node model."
      },
      "tropical_apparent_longitude_deg": {
        "independent_of_this_engine": true,
        "source": "NASA/JPL Horizons",
        "what": "Apparent geocentric ecliptic longitude referred to the ecliptic and TRUE equinox of date, observer at the geocentre (500@399), Horizons observer QUANTITIES='31' (ObsEcLon). Includes light-time, aberration, relativistic deflection and nutation, matching swisseph's default apparent position."
      }
    },
