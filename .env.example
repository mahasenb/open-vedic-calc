CALC_SERVICE_TOKEN=change-me
# The AGPL-3.0 source offer GET /source publishes: where THIS deployment's
# Corresponding Source can be obtained. Optional — leave it unset and the
# service serves the built-in default below. Set it when you run a fork or a
# mirror, so the offer names the source a recipient of your instance can
# actually fetch. It must not be blank: the service refuses to start on an
# empty, whitespace-only, or non-URL value rather than serve an offer that
# leads nowhere.
PUBLIC_SOURCE_URL=https://github.com/mahasenb/open-vedic-calc
